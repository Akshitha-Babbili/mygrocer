# Copy to .env only if you choose to use python-dotenv.
# Otherwise set these as PowerShell env vars (see setup section).

PGHOST=localhost
PGPORT=5432
PGDATABASE=mygrocer_db
PGUSER=postgres
PGPASSWORD=project

# Long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# Set to 1 ONLY when serving over HTTPS (production)
FLASK_COOKIE_SECURE=0